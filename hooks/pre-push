#!/bin/bash
# Pre-push check: every commit that is about to be pushed must be marked as made with a
# Claude Opus model, i.e. its message has a trailer like
#     Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
# Commits without it are listed and the push is stopped.
# Change REQUIRED below to change which model name is accepted.
REQUIRED='^Co-Authored-By:.*Claude Opus'
ZERO=0000000000000000000000000000000000000000

bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue            # deleting a branch: nothing to check
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha --not --remotes"            # new branch: commits no remote has yet
    else
        range="$remote_sha..$local_sha"
    fi
    for sha in $(git rev-list $range); do
        if ! git log -1 --format=%B "$sha" | grep -qiE "$REQUIRED"; then
            echo "  not made by an Opus model: $(git log -1 --format='%h %s' "$sha")"
            bad=1
        fi
    done
done

if [ "$bad" -ne 0 ]; then
    echo
    echo "Push stopped: the commits above have no 'Co-Authored-By: Claude Opus ...' trailer."
    echo "Make new commits with an Opus model, or reword these commits, then push again."
    exit 1
fi
exit 0
